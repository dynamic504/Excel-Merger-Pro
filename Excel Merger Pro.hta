};

function ToggleLang() {
    curLang = (curLang === 'vi') ? 'en' : 'vi';
    document.getElementById('btnLang').innerText = (curLang === 'vi') ? 'EN' : 'VI';
    ApplyLang();
    SaveSettings();
}

function ApplyLang() {
    var d = dict[curLang];
    document.getElementById('lbl_sub').innerText = d.t_sub;
    document.getElementById('c1').innerText = d.c1; 
    document.getElementById('b_fold').innerText = d.b_fold; 
    document.getElementById('b_file').innerText = d.b_file; 
    document.getElementById('l_sub').innerHTML = d.chk_sub;
    document.getElementById('inpFilter').placeholder = d.ph_fil;
    document.getElementById('c2').innerText = d.c2; 
    document.getElementById('l_o1').innerHTML = "<b>" + d.r_o1 + "</b>";
    document.getElementById('l_o2').innerHTML = "<b>" + d.r_o2 + "</b>"; 
    document.getElementById('l_o3').innerHTML = "<b>" + d.r_o3 + "</b>";
    document.getElementById('l_o4').innerHTML = "<b>" + d.r_o4 + "</b>";
    document.getElementById('l_all').innerText = d.k_all; 
    document.getElementById('l_skip').innerText = d.k_skip; 
    document.getElementById('l_src').innerText = d.k_src; 
    document.getElementById('l_clr').innerText = d.k_clr;
    document.getElementById('l_fit').innerText = d.k_fit; 
    document.getElementById('l_rem').innerText = d.k_rem;
    document.getElementById('l_rng').innerText = d.l_rng; 
    document.getElementById('inpRange').placeholder = d.ph_rng; 
    document.getElementById('l_pwd').innerText = d.l_pwd; 
    document.getElementById('inpPass').placeholder = d.ph_pwd;
    document.getElementById('outFileName').placeholder = d.ph_out;
    document.getElementById('outFileName').title = d.ph_out_title;
    document.getElementById('csvDelimiterLbl').innerText = d.csv_delim;
    if(document.getElementById('desc_rng')) document.getElementById('desc_rng').innerText = d.desc_rng;
    if(document.getElementById('desc_pwd')) document.getElementById('desc_pwd').innerText = d.desc_pwd;
    if(document.getElementById('csv_opt1')) document.getElementById('csv_opt1').innerText = d.csv_opt1;
    if(document.getElementById('csv_opt2')) document.getElementById('csv_opt2').innerText = d.csv_opt2;
    if(document.getElementById('author_sig')) document.getElementById('author_sig').innerText = d.sig;
    if(document.getElementById('l_chk_all')) document.getElementById('l_chk_all').innerText = d.chk_all;
    if(document.getElementById('filterDesc')) document.getElementById('filterDesc').innerHTML = d.filterDesc;
    if(document.getElementById('outDesc')) document.getElementById('outDesc').innerHTML = d.outDesc;
    if(document.getElementById('don_title')) document.getElementById('don_title').innerHTML = d.don_title;
    if(document.getElementById('don_msg1')) document.getElementById('don_msg1').innerHTML = d.don_msg1;
    if(document.getElementById('don_bnk')) document.getElementById('don_bnk').innerHTML = d.don_bnk;
    if(document.getElementById('don_int')) document.getElementById('don_int').innerHTML = d.don_int;
    if(document.getElementById('don_msg2')) document.getElementById('don_msg2').innerHTML = d.don_msg2;
    document.getElementById('c3').innerText = d.c3; 
    document.getElementById('a_up').innerHTML = '<span class="act-ico">&#11014;</span> ' + d.a_up; 
    document.getElementById('a_dn').innerHTML = '<span class="act-ico">&#11015;</span> ' + d.a_dn;
    document.getElementById('a_del').innerHTML = '<span class="act-ico">&#128465;</span> ' + d.a_del; 
    document.getElementById('a_clr').innerHTML = '<span class="act-ico">&#10006;</span> ' + d.a_clr;
    document.getElementById('s_lbl').innerText = d.s_lbl; 
    document.getElementById('s_1').innerText = d.s_1;
    document.getElementById('s_2').innerText = d.s_2; 
    document.getElementById('s_3').innerText = d.s_3; 
    document.getElementById('s_4').innerText = d.s_4;
    document.getElementById('btnStart').innerText = d.b_run; 
    document.getElementById('btnStop').innerText = d.b_stp;
    if(isPaused) document.getElementById('btnPause').innerText = d.b_res;
    else document.getElementById('btnPause').innerText = d.b_pau;
    if(fileArray.length==0) document.getElementById('fileCount').innerText = d.fc_none; 
    else document.getElementById('fileCount').innerText = d.fc_ok + fileArray.length + (curLang=='vi'?" file":" files");
    if(!processStart && currentFileIdx==0) { document.getElementById('s-main').innerText = d.st_rdy; document.getElementById('s-sub').innerText = d.st_wait; }
}

// =======================================================
// LƯU & KHÔI PHỤC CÀI ĐẶT
// =======================================================
function GetIniPath() {
    try {
        var url = window.location.href;
        var htaPath = decodeURIComponent(url).replace(/^file:\/\/\//,'').replace(/^file:\/\//,'').replace(/\//g,'\\');
        return fso.GetParentFolderName(htaPath) + "\\ExcelMergerPro.ini";
    } catch(e) {
        // fallback: use htaDir or currDir
        return (htaDir || currDir) + "\\ExcelMergerPro.ini";
    }
}

function LoadSettings() {
    var iniPath = GetIniPath();
    if (!fso.FileExists(iniPath)) return;
    try {
        var f = fso.OpenTextFile(iniPath, 1, false, -1);
        var lines = f.ReadAll().split('\n');
        f.Close();
        var settings = {};
        for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (line == '' || line.indexOf('=') < 0) continue;
            var parts = line.split('=');
            var key = parts.shift().trim();
            var val = parts.join('=').trim();
            settings[key] = val;
        }
        if (settings['lang'] && (settings['lang'] == 'vi' || settings['lang'] == 'en')) {
            curLang = settings['lang'];
            document.getElementById('btnLang').innerText = (curLang === 'vi') ? 'EN' : 'VI';
        }
        if (settings['dir']) {
            setDir(settings['dir']);
            if (fso.FolderExists(currDir)) ScanFolder();
        }
        if (settings['filter']) document.getElementById('inpFilter').value = settings['filter'];
        if (settings['subfolders']) document.getElementById('chkSub').checked = settings['subfolders'] === 'true';
        if (settings['mode']) {
            var mode = settings['mode'];
            document.getElementById('opt1').checked = (mode == '1');
            document.getElementById('opt2').checked = (mode == '2');
            document.getElementById('opt3').checked = (mode == '3');
            document.getElementById('opt4').checked = (mode == '4');
            TogOpts();
        }
        if (settings['allSheets']) document.getElementById('chkAllSheets').checked = (settings['allSheets'] === 'true');
        if (settings['skipHdr']) document.getElementById('chkSkipHdr').checked = (settings['skipHdr'] !== 'false');
        if (settings['addSrc']) document.getElementById('chkAddSrc').checked = (settings['addSrc'] !== 'false');
        if (settings['colorHdr']) document.getElementById('chkColorHdr').checked = (settings['colorHdr'] !== 'false');
        if (settings['autoFit']) document.getElementById('chkAutoFit').checked = (settings['autoFit'] !== 'false');
        if (settings['remBlank']) document.getElementById('chkRemBlank').checked = (settings['remBlank'] === 'true');
        if (settings['range']) document.getElementById('inpRange').value = settings['range'];
        if (settings['password']) document.getElementById('inpPass').value = settings['password'];
        if (settings['delimiter']) document.getElementById('csvDelimiter').value = settings['delimiter'];
    } catch(e) {}
}

function SaveSettings() {
    var iniPath = GetIniPath();
    try {
        var f = fso.CreateTextFile(iniPath, true, true);
        f.WriteLine('lang=' + curLang);
        f.WriteLine('dir=' + currDir);
        f.WriteLine('filter=' + document.getElementById('inpFilter').value.trim());
        f.WriteLine('subfolders=' + document.getElementById('chkSub').checked);
        var mode = '1';
        if (document.getElementById('opt2').checked) mode = '2';
        if (document.getElementById('opt3').checked) mode = '3';
        if (document.getElementById('opt4').checked) mode = '4';
        f.WriteLine('mode=' + mode);
        f.WriteLine('allSheets=' + document.getElementById('chkAllSheets').checked);
        f.WriteLine('skipHdr=' + document.getElementById('chkSkipHdr').checked);
        f.WriteLine('addSrc=' + document.getElementById('chkAddSrc').checked);
        f.WriteLine('colorHdr=' + document.getElementById('chkColorHdr').checked);
        f.WriteLine('autoFit=' + document.getElementById('chkAutoFit').checked);
        f.WriteLine('remBlank=' + document.getElementById('chkRemBlank').checked);
        f.WriteLine('range=' + document.getElementById('inpRange').value.trim());
        f.WriteLine('password=' + document.getElementById('inpPass').value);
        f.WriteLine('delimiter=' + document.getElementById('csvDelimiter').value);
        f.Close();
    } catch(e) {}
}

// =======================================================
// CORE LOGIC V17.7 - HOÀN CHỈNH
// =======================================================
if (!String.prototype.trim) { String.prototype.trim = function(){ return this.replace(/^[\s\uFEFF\xA0]+|[\s\uFEFF\xA0]+$/g,''); }; }

var objExcel=null, targetWb=null, targetSheet=null, fso, shell, isPaused=false, isStopped=false, currentFileIdx=0, fileArray=[], fileArrayFull=[], outName="", currDir="", htaDir="", totalRows=0, errorFiles=[], processStart=null, extCountMap={}, _sn={};
var ALL_EXTS=["xlsx","xls","xlsm","xlsb","csv"];

function Window_OnLoad(){
    window.resizeTo(740, 860);
    fso = new ActiveXObject("Scripting.FileSystemObject");
    shell = new ActiveXObject("WScript.Shell");
    try {
        var cl = oHTA.commandLine || "";
        if(cl != ""){
            var parts = cl.split('"');
            for(var i=0;i<parts.length;i++){
                if(parts[i].indexOf(":\\")!=-1){
                    var p = parts[i].trim();
                    if(fso.FileExists(p)) { htaDir = fso.GetParentFolderName(p); setDir(htaDir); }
                    else if(fso.FolderExists(p)) { htaDir = p; setDir(p); }
                    break;
                }
            }
        }
    } catch(e){}
    if(currDir=="") try{ currDir=shell.CurrentDirectory; }catch(e){}
    if(htaDir=="") htaDir=currDir;
    LoadSettings();
    ApplyLang(); 
    ShowPath(); 
    TogOpts();
    setTimeout(ResizeList, 50);
}

function ResizeList() {
    var el = document.getElementById("fileList");
    var scr = document.getElementById("scroll");
    if(!el || !scr) return;
    el.style.height = "100px"; // Shrink first to get accurate scroll available space
    var elTop = el.getBoundingClientRect().top;
    var scrBottom = scr.getBoundingClientRect().bottom;
    var h = scrBottom - elTop - 45; // Trừ hao thêm cho vùng 'Đã nạp X file' ở dưới cùng và padding
    if (h < 120) h = 120;
    el.style.height = h + "px";
}

window.onresize = ResizeList;
window.onbeforeunload = function(){ SaveSettings(); try{ if(objExcel){ try{objExcel.ScreenUpdating=true;}catch(e){} try{objExcel.EnableEvents=true;}catch(e){} try{objExcel.Calculation=-4105;}catch(e){} try{objExcel.Interactive=true;}catch(e){} objExcel.DisplayAlerts=false; objExcel.Quit(); } }catch(e){} };
function setDir(p){ currDir=p; ShowPath(); SaveSettings(); }
function ShowPath(){ document.getElementById("pathInfo").innerText = currDir || (curLang=='vi'?"(chưa chọn)":"(not selected)"); }

// ========== BROWSE FOLDER ==========
function BrowseFolder(){
    try {
        var objShell = new ActiveXObject("Shell.Application");
        var folder = objShell.BrowseForFolder(0, curLang=='vi'?"Chọn thư mục chứa báo cáo:":"Select folder containing data:", 0, 0);
        if(folder == null) return;
        setDir(folder.Self.Path); 
        outName = MakeOutName(fso.GetBaseName(currDir));
        document.getElementById("outFileName").value = outName; 
        ScanFolder();
        SaveSettings();
    } catch(e){ alert(dict[curLang].msg_err + e.message); }
}

// ========== BROWSE FILES - Đọc thẳng vào RAM (COM) không tạo file tạm ==========
var globalPickerExcel = null;
window.attachEvent("onbeforeunload", function(){
    // Khi người dùng tắt app HTA, tự động dọn sạch tiến trình Excel ngầm trong RAM
    try { if(globalPickerExcel) { globalPickerExcel.Quit(); globalPickerExcel = null; CollectGarbage(); } } catch(e){}
});

function BrowseFiles(){
    try {
        // Tái sử dụng tiến trình Excel duy nhất: không sinh rác, không bị Windows nhầm lẫn cửa sổ
        if(!globalPickerExcel){
            globalPickerExcel = new ActiveXObject("Excel.Application");
            globalPickerExcel.DisplayAlerts = false;
            globalPickerExcel.Caption = "ExcelMergerPicker_" + new Date().getTime();
            globalPickerExcel.Visible = true;
            globalPickerExcel.WindowState = -4143; // xlNormal
            globalPickerExcel.Top = -2000;
            globalPickerExcel.Left = -2000;
        }
        
        // Ép Excel Dialog phải nổi lên trên cùng
        try { shell.AppActivate(globalPickerExcel.Caption); } catch(e){}
        
        var fd = globalPickerExcel.FileDialog(3); // msoFileDialogFilePicker = 3
        fd.Title = curLang=='vi' ? "Chọn file Excel / CSV" : "Select Excel / CSV files";
        try { fd.Filters.Clear(); fd.Filters.Add("Excel & CSV", "*.xls;*.xlsx;*.xlsm;*.xlsb;*.csv", 1); } catch(ef){}
        fd.AllowMultiSelect = true;
        
        var res = fd.Show();
        
        // Kéo focus về lại cửa sổ App HTA sau khi chọn file xong
        try { shell.AppActivate(document.title); } catch(e){}

        if(res == -1){
            var filterStr = document.getElementById('inpFilter').value.trim().toLowerCase();
            var addedCount = 0;
            for(var i=1; i<=fd.SelectedItems.Count; i++){
                var fPath = fd.SelectedItems.Item(i); // Đọc string thẳng từ RAM qua COM
                if(!fso.FileExists(fPath)) continue;
                if(filterStr!=='' && fso.GetFileName(fPath).toLowerCase().indexOf(filterStr)===-1) continue;
                if(InArr(fPath, fileArrayFull)) continue; // CHỐNG TRÙNG LẶP FILE
                fileArray.push(fPath);
                fileArrayFull.push(fPath);
                addedCount++;
            }
            if(addedCount > 0){
                currDir = fso.GetParentFolderName(fileArray[fileArray.length - addedCount]);
                ShowPath();
                outName = MakeOutName('KetQua');
                document.getElementById('outFileName').value = outName;
            }
            BuildExtMap();
            BuildFileList();
            BuildChips();
            SaveSettings();
        }
    } catch(e){
        alert(dict[curLang].msg_err + e.message);
    }
}

function MakeOutName(base){
    var d=new Date();
    return "GOP_"+base+"_"+d.getFullYear()+Pad(d.getMonth()+1)+Pad(d.getDate())+"_"+Pad(d.getHours())+Pad(d.getMinutes())+".xlsx";
}
function Pad(n){ return n<10?"0"+n:""+n; }

// ========== KÉO THẢ FILE / THƯ MỤC ==========
function idxOf(arr, val) { for(var i=0; i<arr.length; i++) if(arr[i]===val) return i; return -1; }
function GetCheckedIndices() {
    var res = []; var chks = document.getElementsByClassName("chk-file");
    for(var i=0; i<chks.length; i++) if(chks[i].checked) res.push(parseInt(chks[i].value));
    return res;
}
function ToggleSelectAllList() {
    var checked = document.getElementById("chkAllList").checked;
    var chks = document.getElementsByClassName("chk-file");
    for(var i=0; i<chks.length; i++) chks[i].checked = checked;
}
function CheckAllSync() {
    var chks = document.getElementsByClassName("chk-file");
    var allChecked = true;
    for(var i=0; i<chks.length; i++) { if(!chks[i].checked) { allChecked = false; break; } }
    document.getElementById("chkAllList").checked = (chks.length > 0 && allChecked);
}

function ScanFolder(){
    fileArray=[]; fileArrayFull=[]; extCountMap={};
    if(!fso.FolderExists(currDir)){
        SetFC(dict[curLang].msg_err + (curLang=='vi'?"Thư mục không tồn tại":"Folder not found"),"err");
        return;
    }
    try{ ScanFolderRecursive(currDir); }catch(e){ alert(dict[curLang].msg_err + e.message); return; }
    fileArrayFull = fileArray.slice();
    SortArr();
    BuildExtMap();
    BuildFileList();
    BuildChips();
    SaveSettings();
}

function ScanFolderRecursive(folderPath){
    var folder = fso.GetFolder(folderPath);
    var fc = new Enumerator(folder.files);
    var filterStr = document.getElementById("inpFilter").value.trim().toLowerCase();
    for(; !fc.atEnd(); fc.moveNext()){
        var fl  = fc.item();
        var ext = fso.GetExtensionName(fl.Name).toLowerCase();
        if((ext=="xlsx"||ext=="xls"||ext=="xlsm"||ext=="xlsb"||ext=="csv") && fl.Name.indexOf("~$")==-1){
            if(fl.Name.toLowerCase() != (outName||"").toLowerCase()){ 
                if(filterStr != "" && fl.Name.toLowerCase().indexOf(filterStr) == -1) continue;
                if(InArr(fl.Path, fileArrayFull)) continue; // CHỐNG TRÙNG LẶP (An toàn khi Append)
                fileArray.push(fl.Path);
                fileArrayFull.push(fl.Path);
            }
        }
    }
    if(document.getElementById("chkSub").checked){
        var subs = new Enumerator(folder.SubFolders);
        for(; !subs.atEnd(); subs.moveNext()){ try{ ScanFolderRecursive(subs.item().Path); }catch(e){} }
    }
}

function SortArr(){
    var mode = document.getElementById("sortMode").value;
    if(mode=="az") fileArray.sort(function(a,b){ return fso.GetFileName(a).toLowerCase()>fso.GetFileName(b).toLowerCase()?1:-1; });
    else if(mode=="za") fileArray.sort(function(a,b){ return fso.GetFileName(a).toLowerCase()<fso.GetFileName(b).toLowerCase()?1:-1; });
    else if(mode=="date") fileArray.sort(function(a,b){ try{ return fso.GetFile(a).DateLastModified<fso.GetFile(b).DateLastModified?1:-1; }catch(e){return 0;} });
}
function OnSort(){ SortArr(); BuildFileList(); }

function BuildExtMap(){ extCountMap={}; for(var i=0;i<fileArrayFull.length;i++){ var ext=fso.GetExtensionName(fileArrayFull[i]).toLowerCase(); extCountMap[ext]=(extCountMap[ext]||0)+1; } }

function BuildFileList(checkedArr){
    checkedArr = checkedArr || [];
    var el = document.getElementById("fileList");
    el.innerHTML = "";
    for(var i=0;i<fileArray.length;i++){
        var dir = fso.GetParentFolderName(fileArray[i]), rel = "";
        if(currDir!=""&&dir.toLowerCase()!=currDir.toLowerCase()){ rel = dir.toLowerCase().indexOf(currDir.toLowerCase())==0 ? dir.substring(currDir.length+1)+"\\" : fso.GetBaseName(dir)+"\\"; }
        var fname = fso.GetFileName(fileArray[i]), size = "";
        try{ var b=fso.GetFile(fileArray[i]).Size;
        size = b<1048576?" ["+Math.ceil(b/1024)+"KB]":" ["+(b/1048576).toFixed(1)+"MB]"; }catch(e){}
        
        var div = document.createElement("div");
        div.className = "file-item";
        div.title = fileArray[i];
        
        var chk = document.createElement("input");
        chk.type = "checkbox";
        chk.className = "chk-file";
        chk.value = i;
        if(idxOf(checkedArr, i) !== -1) chk.checked = true;
        chk.onclick = function(e){ e.cancelBubble=true; CheckAllSync(); };
        
        div.onclick = (function(c){ return function(){ c.checked = !c.checked; CheckAllSync(); }; })(chk);
        
        var span = document.createElement("span");
        span.innerText = " "+(i+1)+".  "+rel+fname+size;
        
        div.appendChild(chk);
        div.appendChild(span);
        el.appendChild(div);
    }
    if(fileArray.length>0) {
        SetFC(dict[curLang].fc_ok + fileArray.length + (curLang=='vi'?" file":" files"),"ok");
    } else {
        SetFC(dict[curLang].fc_none,"err");
        var chkAll = document.getElementById("chkAllList");
        if(chkAll) chkAll.checked = false;
    }
}

function SetFC(msg,cls){ var el=document.getElementById("fileCount"); el.style.color=cls=="err"?"#AE1C28":"#008A5E"; el.innerText=msg; }

function BuildChips(){
    var area=document.getElementById("extArea");
    area.innerHTML="";
    for(var i=0;i<ALL_EXTS.length;i++){
        var ext=ALL_EXTS[i];
        if(!extCountMap[ext]) continue;
        var lbl=document.createElement("label");
        lbl.className="chip on";
        lbl.id="chip_"+ext;
        lbl.innerHTML='<input type="checkbox" id="chk_'+ext+'" checked>.'+ext+'<span class="cnt">'+extCountMap[ext]+'</span>';
        lbl.onclick = (function(e){ return function(){ TogChip(e); return false; }; })(ext);
        area.appendChild(lbl);
    }
}

function TogChip(ext){
    var chk = document.getElementById("chk_"+ext);
    if(!chk) return;
    chk.checked = !chk.checked;
    document.getElementById("chip_"+ext).className = "chip" + (chk.checked?" on":"");
    var onExts=[];
    for(var i=0;i<ALL_EXTS.length;i++){
        var c=document.getElementById("chk_"+ALL_EXTS[i]);
        if(c&&c.checked) onExts.push(ALL_EXTS[i]);
    }
    fileArray=[];
    for(var j=0;j<fileArrayFull.length;j++){
        var e2=fso.GetExtensionName(fileArrayFull[j]).toLowerCase();
        for(var k=0;k<onExts.length;k++){ if(e2==onExts[k]){ fileArray.push(fileArrayFull[j]); break; } }
    }
    SortArr();
    BuildFileList();
}

function DelSel(){
    var checked = GetCheckedIndices();
    if(checked.length === 0) return;
    if(!confirm(curLang=='vi' ? "Bạn muốn xóa " + checked.length + " file đã chọn khỏi danh sách?" : "Remove " + checked.length + " selected file(s)?")) return;
    var na=[], naf=[];
    var delPaths = [];
    for(var j=0; j<checked.length; j++) delPaths.push(fileArray[checked[j]]);
    
    for(var j=0; j<fileArray.length; j++) if(idxOf(delPaths, fileArray[j]) === -1) na.push(fileArray[j]);
    for(var k=0; k<fileArrayFull.length; k++) if(idxOf(delPaths, fileArrayFull[k]) === -1) naf.push(fileArrayFull[k]);
    
    fileArray=na; fileArrayFull=naf;
    var chkAll = document.getElementById("chkAllList");
    if(chkAll) chkAll.checked = false;
    BuildExtMap(); BuildFileList(); BuildChips(); SaveSettings();
}

function ClearAll(){
    if(fileArray.length==0) return;
    fileArray=[]; fileArrayFull=[]; document.getElementById("fileList").innerHTML=""; 
    var chkAll = document.getElementById("chkAllList");
    if(chkAll) chkAll.checked = false;
    BuildChips(); SetFC(dict[curLang].fc_none,"dim"); SaveSettings();
}

function MoveUp(){
    var checked = GetCheckedIndices();
    if(checked.length === 0) return;
    for(var j=0; j<checked.length; j++){
        var i = checked[j];
        if(i > 0 && idxOf(checked, i-1) === -1) {
            var t=fileArray[i]; fileArray[i]=fileArray[i-1]; fileArray[i-1]=t;
            checked[j] = i-1;
        }
    }
    BuildFileList(checked);
}

function MoveDown(){
    var checked = GetCheckedIndices();
    if(checked.length === 0) return;
    for(var j=checked.length-1; j>=0; j--){
        var i = checked[j];
        if(i < fileArray.length - 1 && idxOf(checked, i+1) === -1) {
            var t=fileArray[i]; fileArray[i]=fileArray[i+1]; fileArray[i+1]=t;
            checked[j] = i+1;
        }
    }
    BuildFileList(checked);
}
function OpenExp(){ if(currDir) try{ shell.Run('explorer.exe "'+currDir+'"'); }catch(e){} }
function TogSub(){ if(currDir&&fso.FolderExists(currDir)) ScanFolder(); SaveSettings(); }
function InArr(v,a){ for(var i=0;i<a.length;i++){if(a[i]==v)return true;}return false; }

function getModeAppend()  { return document.getElementById("opt1").checked; }
function getModeSep()     { return document.getElementById("opt2").checked; }
function getModeCombine() { return document.getElementById("opt3").checked; }
function getModeGroup()   { return document.getElementById("opt4").checked; }
function getAllSheets()   { return document.getElementById("chkAllSheets").checked; }
function getSkipHdr()     { return document.getElementById("chkSkipHdr").checked; }
function getAddSrc()      { return document.getElementById("chkAddSrc").checked; }
function getColorHdr()    { return document.getElementById("chkColorHdr").checked; }
function getAutoFit()     { return document.getElementById("chkAutoFit").checked; }

function SetStatus(main,sub,pct){ document.getElementById("s-main").innerText=main; document.getElementById("s-sub").innerText=sub; if(pct!="") document.getElementById("s-pct").innerText=pct; }
function uqSheet(base){ var s=base.replace(/[:\\/\?\*\[\]]/g,"_"); if(s.length>28) s=s.substring(0,28); if(!_sn[s]){_sn[s]=1;return s;} _sn[s]++; return s+"_"+_sn[s]; }
function RGB2XL(r,g,b){ return r+(g*256)+(b*65536); }

// ========== XỬ LÝ GỘP ==========
function StartProcess(){
    if(fileArray.length==0){ alert(dict[curLang].msg_emp); return; }
    var cn=document.getElementById("outFileName").value.trim();
    if(cn=="") cn=MakeOutName("KetQua");
    if(cn.toLowerCase().indexOf(".xlsx")==-1) cn+=".xlsx";
    outName=cn;
    if(currDir=="") currDir=fso.GetParentFolderName(fileArray[0]);
    SaveSettings();

    errorFiles=[]; totalRows=0; _sn={}; isPaused=false; isStopped=false; currentFileIdx=0;
    processStart=new Date();
    document.getElementById("btnStart").disabled=true;
    document.getElementById("btnPause").disabled=false;
    document.getElementById("btnStop").disabled=false;
    document.getElementById("prog-bar").style.width="0%";

    try{
        objExcel = new ActiveXObject("Excel.Application");
        objExcel.Visible = false;
        objExcel.DisplayAlerts = false; 
        try { objExcel.Interactive = false; } catch(e) {} // Prevent ANY hidden dialog from freezing the app
        try { objExcel.AutomationSecurity = 3; } catch(e) {} // msoAutomationSecurityForceDisable = 3
        try { objExcel.AskToUpdateLinks = false; } catch(e) {}
        try { objExcel.ScreenUpdating = false; } catch(e) {}
        try { objExcel.Calculation = -4135; } catch(e) {}
        try { objExcel.EnableEvents = false; } catch(e) {}
        targetWb = objExcel.Workbooks.Add();
        while(targetWb.Sheets.Count > 1) { targetWb.Sheets(targetWb.Sheets.Count).Delete(); }
    }catch(e){ alert(dict[curLang].msg_err+e.message); ResetBtns(); return; }

    targetSheet=null;
    if(getModeAppend() || getModeCombine()){ 
        targetSheet=targetWb.Sheets(1);
        try { targetSheet.Name = dict[curLang].mergedSheet; } catch(e) {}
    }
    
    SetStatus(curLang=='vi'?"ĐANG XỬ LÝ...":"PROCESSING...", "Đang khởi tạo...","0%");
    setTimeout(RunLoop,50);
}

function RunLoop(){
    if(isStopped){ FinishUp(false); return; }
    if(isPaused) { setTimeout(RunLoop,300); return; }
    if(currentFileIdx>=fileArray.length){ FinishUp(true); return; }

    var fPath = fileArray[currentFileIdx];
    var done  = currentFileIdx, total=fileArray.length;
    var pct   = Math.floor(done/total*100);
    document.getElementById("prog-bar").style.width=pct+"%";
    SetStatus((curLang=='vi'?"XỬ LÝ: ":"PROCESSING: ")+(done+1)+"/"+total, fso.GetFileName(fPath), pct+"%");

    try{
        var ext      = fso.GetExtensionName(fPath).toLowerCase();
        var fileBase = fso.GetBaseName(fso.GetFileName(fPath));
        var skipHdr  = getSkipHdr(), addSrc=getAddSrc();
        var cRng     = document.getElementById("inpRange").value.trim();
        var cPwd     = document.getElementById("inpPass").value.trim();
        var delimiter = document.getElementById("csvDelimiter").value;

        var srcWb;
        var isCSV = (ext == "csv");
        if(isCSV) {
            var isTab = (delimiter == "tab");
            var isSemi = (delimiter == ";");
            var isComma = (delimiter == ",");
            objExcel.Workbooks.OpenText(fPath, 65001, 1, 1, 1, false, isTab, isSemi, isComma, false, false);
            srcWb = objExcel.Workbooks(objExcel.Workbooks.Count);
        } else {
            if(cPwd != "") srcWb = objExcel.Workbooks.Open(fPath, 0, true, 5, cPwd, "", true);
            else srcWb = objExcel.Workbooks.Open(fPath, 0, true, 5, "", "", true);
        }

        var allSh = getAllSheets() || getModeGroup();
        var shCnt = allSh ? srcWb.Sheets.Count : 1;
        
        for(var s=1; s<=shCnt; s++){
            try{
                var srcSh = srcWb.Sheets(s);
                var usedR;
                if(cRng != "") { try { usedR = srcSh.Range(cRng); } catch(e) { usedR = GetRealUsedRange(srcSh); } }
                else { usedR = GetRealUsedRange(srcSh); }

                var nRows = usedR.Rows.Count;
                var nCols = usedR.Columns.Count;
                if(nRows <= 0 || nCols <= 0) continue;

                if(getModeGroup()){
                    var sName = srcSh.Name;
                    var tgtSh = null;
                    try { tgtSh = targetWb.Sheets(sName); }
                    catch(e) {
                        if (targetWb.Sheets.Count == 1 && targetWb.Sheets(1).UsedRange.Rows.Count <= 1 && targetWb.Sheets(1).Range("A1").Value == null) {
                            targetWb.Sheets(1).Name = sName;
                            tgtSh = targetWb.Sheets(sName);
                        } else {
                            tgtSh = targetWb.Sheets.Add();
                            tgtSh.Move(null, targetWb.Sheets(targetWb.Sheets.Count));
                            tgtSh.Name = sName;
                        }
                    }
                    AppendToSheet(usedR, nRows, nCols, tgtSh, fileBase, skipHdr, addSrc);
                }

                if((getModeAppend() || getModeCombine()) && targetSheet){
                    AppendToSheet(usedR, nRows, nCols, targetSheet, fileBase, skipHdr, addSrc);
                }

                if(getModeSep() || getModeCombine()){
                    var copied = false;
                    try {
                        srcSh.Copy(null, targetWb.Sheets(targetWb.Sheets.Count));
                        copied = true;
                    } catch(ecopy) {}
                    
                    if(!copied) {
                        try {
                            var fbSh = targetWb.Sheets.Add();
                            fbSh.Move(null, targetWb.Sheets(targetWb.Sheets.Count));
                            AppendToSheet(usedR, nRows, nCols, fbSh, fileBase, false, false);
                        } catch(efb) {
                            errorFiles.push("[FALLBACK ADD ERROR] " + efb.message);
                        }
                    }
                    var nm=uqSheet(shCnt>1?fileBase+"_"+srcSh.Name:fileBase);
                    try{ targetWb.Sheets(targetWb.Sheets.Count).Name=nm; }catch(ne2){}
                }
            }catch(se){ errorFiles.push("[SHEET] "+fso.GetFileName(fPath)+" Sheet"+s+": "+se.message); }
        }
        try { srcWb.Close(false); } catch(ec) {}
    }catch(e){ errorFiles.push("[FILE] "+fso.GetFileName(fPath)+" - "+e.message); }

    currentFileIdx++;
    setTimeout(RunLoop, 10);
}

// AppendToSheet V2: dùng Copy/PasteSpecial(Values) hoặc gán Value trực tiếp
function AppendToSheet(srcRange, nRows, nCols, tgtSheet, fileBase, skipHdr, addSrc) {
    var lr = tgtSheet.UsedRange.Rows.Count;
    if (lr == 1 && tgtSheet.Range("A1").Value == null) lr = 0;
    var startSrcRow = (skipHdr && lr > 0) ? 2 : 1; 
    var copyRows = nRows - startSrcRow + 1;
    if (copyRows <= 0) return;
    var destStartRow = lr + 1;
    var destStartCol = addSrc ? 2 : 1;
    var copyRange, destRange;
    try {
        copyRange = (startSrcRow == 1) ? srcRange : srcRange.Offset(startSrcRow - 1, 0).Resize(copyRows, nCols);
        destRange = tgtSheet.Range(tgtSheet.Cells(destStartRow, destStartCol), tgtSheet.Cells(destStartRow + copyRows - 1, destStartCol + nCols - 1));
    } catch(erng) {
        errorFiles.push("[RANGE ERROR] Dữ liệu quá lớn, vượt quá 1 triệu dòng của Excel.");
        return;
    }
    
    var success = false;
    try {
        copyRange.Copy();
        tgtSheet.Cells(destStartRow, destStartCol).PasteSpecial(12); // xlPasteValuesAndNumberFormats
        tgtSheet.Cells(destStartRow, destStartCol).PasteSpecial(-4122); // xlPasteFormats
        objExcel.CutCopyMode = false;
        success = true;
    } catch(e1) {
        try {
            destRange.Value = copyRange.Value; // Fast COM SafeArray transfer
            success = true;
        } catch(e2) {
            try {
                copyRange.Copy(tgtSheet.Cells(destStartRow, destStartCol)); // Direct copy with formats
                success = true;
            } catch(e3) { }
        }
    }
    
    if(!success) {
        // Ultimate fallback: cell by cell (Limit to 500 rows to prevent IE script freeze)
        var limitRows = (copyRows > 500) ? 500 : copyRows;
        try {
            var flat = [], useFlat = false;
            try { flat = new VBArray(srcRange.Value).toArray(); useFlat = (flat.length == nRows * nCols); } catch(ev){}
            for (var r = startSrcRow - 1; r < (startSrcRow - 1 + limitRows); r++) {
                var destRow = destStartRow + (r - (startSrcRow - 1));
                for (var c = 0; c < nCols; c++) {
                    var v = "";
                    if (useFlat) { v = flat[r * nCols + c]; }
                    else { try { v = srcRange.Cells(r + 1, c + 1).Value; } catch(ec){} }
                    tgtSheet.Cells(destRow, destStartCol + c).Value = (v === null || v === undefined) ? "" : v;
                }
            }
            if(copyRows > 500) errorFiles.push("[WARNING] File quá lớn/phức tạp, chỉ copy 500 dòng để tránh treo máy.");
        } catch(ef) { errorFiles.push("[APPEND ERROR] " + ef.message); return; }
    }
    
    // Ghi cột tên file nguồn
    if (addSrc) {
        try {
            var srcColStart = (destStartRow == 1) ? 2 : destStartRow;
            if (srcColStart <= destStartRow + copyRows - 1) {
                tgtSheet.Range(tgtSheet.Cells(srcColStart, 1), tgtSheet.Cells(destStartRow + copyRows - 1, 1)).Value = fileBase;
            }
        } catch(esrc) {}
    }
    totalRows += copyRows;
}

function PauseBtn(){ isPaused=!isPaused; document.getElementById("btnPause").innerText = isPaused ? dict[curLang].b_res : dict[curLang].b_pau; }
function StopBtn(){ if(shell.Popup(curLang=='vi'?"Dừng tiến trình hiện tại?":"Stop current process?",0,curLang=='vi'?"Xác nhận":"Confirm",36)==6) isStopped=true; }
function ResetBtns(){
    document.getElementById("btnStart").disabled=false;
    document.getElementById("btnPause").disabled=true;
    document.getElementById("btnStop").disabled=true;
    document.getElementById("btnPause").innerText = dict[curLang].b_pau;
}

function WriteLog(){
    var logPath="";
    try{
        logPath=currDir+"\\[GOP]_Log_"+Pad(new Date().getMonth()+1)+Pad(new Date().getDate())+".txt";
        var tf=fso.CreateTextFile(logPath,true,true); // Use Unicode (true) to prevent crash with Vietnamese text
        tf.WriteLine("=== EXCEL MERGER PRO LOG ===");
        for(var i=0;i<errorFiles.length;i++) tf.WriteLine((i+1)+". "+errorFiles[i]);
        tf.Close();
    }catch(e){}
    return logPath;
}

function GetRealUsedRange(sh) {
    var rStart = 1, cStart = 1;
    var rCount = 1, cCount = 1;
    try {
        rStart = sh.UsedRange.Row;
        cStart = sh.UsedRange.Column;
        rCount = sh.UsedRange.Rows.Count;
        cCount = sh.UsedRange.Columns.Count;
        
        var lastR = rStart;
        var lastC = cStart;
        var foundR = false, foundC = false;
        
        // Method 1: Find with undefined
        try {
            var fR = sh.Cells.Find("*", undefined, -4123, 2, 1, 2);
            if(fR) { lastR = fR.Row; foundR = true; }
            var fC = sh.Cells.Find("*", undefined, -4123, 2, 2, 2);
            if(fC) { lastC = fC.Column; foundC = true; }
        } catch(e1) {}
        
        // Method 2: Find with null
        if(!foundR || !foundC) {
            try {
                var fR = sh.Cells.Find("*", null, -4123, 2, 1, 2);
                if(fR) { lastR = fR.Row; foundR = true; }
                var fC = sh.Cells.Find("*", null, -4123, 2, 2, 2);
                if(fC) { lastC = fC.Column; foundC = true; }
            } catch(e2) {}
        }

        // Method 3: Find with sh.Cells(1,1)
        if(!foundR || !foundC) {
            try {
                var fR = sh.Cells.Find("*", sh.Cells(1,1), -4123, 2, 1, 2);
                if(fR) { lastR = fR.Row; foundR = true; }
                var fC = sh.Cells.Find("*", sh.Cells(1,1), -4123, 2, 2, 2);
                if(fC) { lastC = fC.Column; foundC = true; }
            } catch(e3) {}
        }
        
        // Method 4: Safe 1-argument Find and FindPrevious
        if(!foundR || !foundC) {
            try {
                var f1 = sh.Cells.Find("*");
                if(f1) {
                    var fR = sh.Cells.FindPrevious(f1);
                    if(fR) { lastR = fR.Row; foundR = true; }
                    var fC = sh.Cells.FindPrevious(f1); // Fallback column
                    if(fC && fC.Column > lastC) { lastC = fC.Column; foundC = true; }
                } else {
                    lastR = rStart; lastC = cStart; foundR = true; foundC = true;
                }
            } catch(e4) {}
        }
        
        if(foundR) rCount = lastR - rStart + 1;
        if(foundC) cCount = lastC - cStart + 1;
    } catch(e) {}
    
    if(rCount < 1) rCount = 1;
    if(cCount < 1) cCount = 1;
    
    // Safety cap to prevent a single junk file from filling the entire Excel limit
    if(rCount > 50000) rCount = 50000; 
    if(cCount > 1000) cCount = 1000;
    
    return sh.Range(sh.Cells(rStart, cStart), sh.Cells(rStart + rCount - 1, cStart + cCount - 1));
}



function FinishUp(isComplete){
    var elapsed=Math.round((new Date()-processStart)/1000);
    var elStr=elapsed<60?elapsed+"s":Math.floor(elapsed/60)+"m"+(elapsed%60)+"s";
    var safeOut = outName.replace(/[<>:"\/\\|\?\*\[\]]/g,"_");
    var savePath = htaDir+"\\"+safeOut;
    var saveOk=false, savedPath="";

    try{
        if(document.getElementById("chkRemBlank").checked) {
            for(var x=1; x<=targetWb.Sheets.Count; x++){
                var s = targetWb.Sheets(x);
                try {
                    var lastR = s.UsedRange.Rows.Count + s.UsedRange.Row - 1;
                    for(var r = lastR; r >= 1; r--){
                        if(objExcel.WorksheetFunction.CountA(s.Rows(r)) == 0){ s.Rows(r).Delete(); }
                    }
                } catch(e){}
            }
        }
        var applyPostProcess = getModeAppend() || getModeCombine() || getModeGroup() || getModeSep();
        if(applyPostProcess){
            for(var x=1; x<=targetWb.Sheets.Count; x++){
                var s = targetWb.Sheets(x);
                // Only set source column header when addSrc is enabled and cell is empty or not yet labeled
                if(getAddSrc() && !getModeSep()){
                    try{
                        var curHdrVal = s.Cells(1,1).Value;
                        if(curHdrVal == null || curHdrVal == "" || curHdrVal == undefined){
                            s.Cells(1,1).Value = dict[curLang].srcCol;
                            s.Cells(1,1).Font.Bold = true;
                        }
                    }catch(e){}
                }
                if(getColorHdr()){
                    try{
                        var hdr=s.Rows(1);
                        hdr.Interior.Color=RGB2XL(174,28,40);
                        hdr.Font.Color=RGB2XL(255,255,255); hdr.Font.Bold=true;
                        s.Activate(); s.Rows(2).Select();
                        try { objExcel.ActiveWindow.FreezePanes=true; } catch(ef){}
                    }catch(e){}
                }
                if(getAutoFit()){ try{ s.UsedRange.Columns.AutoFit(); }catch(e){} }
            }
        }
        if(getModeSep() && targetWb.Sheets.Count>1){ try{ targetWb.Sheets(1).Delete(); }catch(e){} }
        if(fso.FileExists(savePath)) try{ fso.DeleteFile(savePath, true); }catch(e){}

        try {
            targetWb.SaveAs(savePath);
            saveOk=true; savedPath=savePath;
        } catch(se1) {
            var warnMsg = curLang=='vi' ? "File kết quả đang mở hoặc không ghi được.\nĐổi tên?" : "Output file locked, rename?";
            if(shell.Popup(warnMsg, 0, "Lỗi", 36) == 6){
                objExcel.Visible = true;
                try{ targetWb.Activate(); }catch(e){}
                var newPath = objExcel.GetSaveAsFilename(safeOut, "Excel Workbook (*.xlsx), *.xlsx");
                if (newPath != false && newPath != "False" && newPath != "false"){
                    try { targetWb.SaveAs(newPath); saveOk = true; savedPath = newPath; } catch(se2) { errorFiles.push("[SAVE] " + se2.message); }
                } else { errorFiles.push("[CANCEL]"); }
                objExcel.Visible = false;
            } else { errorFiles.push("[SAVE] " + se1.message); }
        }
    }catch(mainE){ errorFiles.push("[FINAL] "+mainE.message); }

    try{ objExcel.ScreenUpdating = true; }catch(e){}
    try{ objExcel.Calculation = -4105; }catch(e){}
    try{ objExcel.EnableEvents = true; }catch(e){}

    document.getElementById("prog-bar").style.width="100%";
    ResetBtns();
    if(!saveOk){
        try{ targetWb.Close(false); }catch(e){} 
        try{objExcel.ScreenUpdating=true;}catch(e){} try{objExcel.EnableEvents=true;}catch(e){} try{objExcel.Calculation=-4105;}catch(e){} try{objExcel.Interactive=true;}catch(e){} try{objExcel.CutCopyMode=false;}catch(e){} try{objExcel.Quit();}catch(e){} 
        objExcel = null;
        alert(dict[curLang].msg_err+"Không thể lưu file (File đang mở?)"); return;
    }
    
    // Khôi phục các tính năng của Excel trước khi hiện bảng thông báo
    try{objExcel.ScreenUpdating=true;}catch(e){} 
    try{objExcel.EnableEvents=true;}catch(e){} 
    try{objExcel.Calculation=-4105;}catch(e){} 
    try{objExcel.Interactive=true;}catch(e){} 
    try{objExcel.CutCopyMode=false;}catch(e){}
    
    var logPath=""; if(errorFiles.length>0) logPath=WriteLog();
    
    SetStatus(curLang=='vi'?"HOÀN THÀNH":"COMPLETED!", fso.GetFileName(savedPath), "100%");
    var msg = dict[curLang].msg_fin.replace("{0}", currentFileIdx).replace("{1}", fileArray.length).replace("{2}", totalRows).replace("{3}", elStr);
    if(errorFiles.length>0) msg += dict[curLang].msg_warn.replace("{0}", errorFiles.length);
    
    if(shell.Popup(msg,0,dict[curLang].msg_ok,36)==6){
        objExcel.Visible = true; 
        try{ targetWb.Activate(); }catch(e){} 
        objExcel = null; // Bàn giao lại cho người dùng, không Quit
    } else {
        try{ targetWb.Close(false); }catch(e){} 
        try{ objExcel.Quit(); }catch(e){} 
        objExcel = null;
    }

    if(errorFiles.length>0 && logPath!=""){
        if(shell.Popup(curLang=='vi'?"Mở Log lỗi?":"Open Log?",0,"Log",36)==6) shell.Run('notepad.exe "'+logPath+'"');
    }
}

function ShowDonate() { document.getElementById('donateModal').style.display='block'; }
function HandleImageError() { document.getElementById('agri-logo').style.display='none'; document.getElementById('fallback-logo').style.display='block'; }
function TogOpts() {
    var isGrp = document.getElementById("opt4").checked;
    var chkAll = document.getElementById("chkAllSheets");
    var lblAll = document.getElementById("l_all");
    if(isGrp) { chkAll.checked = true; chkAll.disabled = true; lblAll.className = "disabled-lbl"; } 
    else { chkAll.disabled = false; lblAll.className = ""; }
}
</script>
