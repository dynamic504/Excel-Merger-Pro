                <tr>
                    <td width="50%" align="center" valign="top" style="border:1px solid #eee; background:#f9fbfd; border-radius:5px;">
                        <b style="color:#1a2533; font-size:14px;" id="don_bnk">Chuyển khoản Ngân hàng</b><br>
                        <span style="color:#AE1C28; font-weight:bold;">MB Bank</span> - <span style="font-weight:bold; color:#008A5E;">0973 110 555</span><br>
