                <td width="50%"><label><input type="radio" name="m" id="opt2" onclick="TogOpts()"> <span id="l_o2"><b>Nhiều Sheet riêng</b></span></label></td>
            </tr>
            <tr>
                <td><label><input type="radio" name="m" id="opt3" onclick="TogOpts()"> <span id="l_o3"><b>Kết hợp</b></span></label></td>
                <td><label><input type="radio" name="m" id="opt4" onclick="TogOpts()"> <span id="l_o4"><b>Gộp theo Tên Sheet</b></span> <span class="badge-new">MỚI</span></label></td>
            </tr>
            <tr><td colspan="2"><hr style="border:0; border-top:1px dashed #c8d4e3; margin:2px 0;"></td></tr>
        </table>
     
        <table class="compact-table">
            <tr>
                <td width="50%"><label><input type="checkbox" id="chkAllSheets"> <span id="l_all">Gom tất cả Sheet con</span></label></td>
