                        <img src="data:image/png;base64," style="width:180px; height:180px; margin-top:10px; border-radius:5px; border:1px solid #ddd;" />
                    </td>
                    <td width="10"></td>
                    <td width="50%" align="center" valign="top" style="border:1px solid #eee; background:#f9fbfd; border-radius:5px;">
                        <b style="color:#1a2533; font-size:14px;" id="don_int">Quốc tế (International)</b><br>
                        <span style="color:#003087; font-weight:bold;">PayPal</span><br>
                        Link: <a href="https://paypal.me/VuThaiAnh1510" target="_blank" style="color:#0070ba; font-weight:bold; text-decoration:none;">paypal.me/VuThaiAnh1510</a><br>
