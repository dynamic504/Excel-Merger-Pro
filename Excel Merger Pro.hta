                <td><label><input type="checkbox" id="chkAddSrc" checked> <span id="l_src">Thêm cột Tên file gốc</span></label></td>
                <td><label><input type="checkbox" id="chkColorHdr" checked> <span id="l_clr">Tô màu Header</span></label></td>
